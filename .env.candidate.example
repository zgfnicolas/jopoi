# S16: copiar a .env.candidate.local (ignorado por Git). No completar este archivo versionado.
# --env-file: plantilla estricta sin NEXT_PUBLIC_ ni variables de otros servicios.
# --vercel-env-file: exportación de Vercel; selecciona solo variables de Jopói sin fallback.
NODE_ENV=production
DATABASE_URL=
DIRECT_URL=
# Alternativa a DIRECT_URL sincronizada por la integración nativa de Vercel.
DATABASE_URL_UNPOOLED=
SESSION_SECRET=
CRON_SECRET=
# Origen HTTPS definitivo del proveedor, disponible ANTES del build de /demo y QR.
APP_URL=
# Solo testnet, clave DER privada. Topic/generación nuevos no reemplazan vínculos históricos.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_TOPIC_ID=
HCS_CONFIGURATION_GENERATION=
HCS_DAILY_LIMIT=100
