# S01: plantilla sin credenciales. Copiar a .env.local y completar solo lo necesario.
# Ninguna variable de esta plantilla debe llevar el prefijo NEXT_PUBLIC_.
# Referencia completa: docs/configuracion-y-entorno.md

# PostgreSQL de aplicación (pooled en Neon). S03: db:local:setup prepara las URL locales.
DATABASE_URL=
# PostgreSQL directo para migraciones/estado. Nunca sustituirlo por una URL ficticia.
DIRECT_URL=

# Generar cada secreto por separado con 32 bytes aleatorios; mínimo 32 caracteres.
SESSION_SECRET=
CRON_SECRET=

# En desarrollo, vacío utiliza http://127.0.0.1:3000.
# En producción, obligatorio: origen HTTPS sin credenciales, ruta, query ni fragmento.
APP_URL=

# Exclusivamente Hedera testnet. IDs numéricos 0.0.N; clave privada solo en servidor.
# S09 comprobará la clave con el SDK y la disponibilidad real del operador/topic.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_TOPIC_ID=

# Entero entre 1 y 100. Ausente o vacío utiliza 100. Aplicación efectiva en S10.
HCS_DAILY_LIMIT=100
