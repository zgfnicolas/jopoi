{
  "name": "jopoi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "prisma generate && next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc -p tsconfig.strict.json --noEmit --pretty false",
    "typecheck:report": "node scripts/strict-report.mjs",
    "lint": "biome lint . --error-on-warnings",
    "format:check": "biome format",
    "format": "biome format --write",
    "quality:check": "node --import tsx scripts/quality.ts",
    "test:quality": "node --test --test-concurrency=1 tests/quality/gate.test.mjs",
    "test:domain": "node --import tsx --test tests/domain/operation-snapshot.test.ts tests/domain/persisted-operation.test.ts",
    "test": "vitest run",
    "test:api": "vitest run",
    "test:cli": "node --import tsx --test --test-concurrency=1 tests/cli/entrega.test.ts tests/cli/seguridad.test.ts",
    "test:security": "node --test --test-concurrency=1 tests/security/dependencies.test.mjs tests/security/audit-gate.test.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:audit:all": "npm audit --audit-level=high",
    "db:audit": "node --import tsx scripts/database-audit.ts",
    "s21:benchmark": "node --import tsx scripts/s21-benchmark.ts",
    "s21:https": "node --import tsx scripts/s21-https-cookie.ts",
    "s21:report": "node --import tsx scripts/s21-report.ts",
    "test:e2e": "playwright test",
    "acceptance:check": "node --import tsx -- scripts/acceptance.ts check",
    "acceptance:live": "node --import tsx -- scripts/acceptance.ts live",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "node --import tsx -- scripts/database.ts migrate",
    "db:status": "node --import tsx -- scripts/database.ts status",
    "db:check": "node --import tsx -- scripts/database.ts check",
    "db:local:setup": "tsx scripts/local-postgres.ts setup",
    "db:local:prepare": "tsx scripts/local-postgres.ts prepare",
    "db:local": "tsx scripts/local-postgres.ts start",
    "db:local:stop": "tsx scripts/local-postgres.ts stop",
    "db:local:status": "tsx scripts/local-postgres.ts status",
    "contacts:export": "node --import tsx -- scripts/export-contacts.ts",
    "hedera:topic": "node --import tsx -- scripts/create-topic.ts",
    "maintenance": "node --import tsx -- scripts/maintenance.ts",
    "delivery:check": "node --import tsx -- scripts/delivery.ts check",
    "delivery:build": "node --import tsx -- scripts/delivery.ts build",
    "ops:status": "node --import tsx -- scripts/ops-status.ts",
    "test:seo": "node --import tsx tests/seo/production.ts",
    "test:ui:tokens": "node --import tsx --test tests/ui/tokens.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@hiero-ledger/sdk": "2.90.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "canonicalize": "5.1.0",
    "dotenv": "18.0.9",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "overrides": {
    "@hiero-ledger/sdk@2.90.1": {
      "ethers@6.16.0": {
        "ws": "8.21.0"
      }
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.4",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsqr": "1.4.0",
    "lighthouse": "13.6.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
