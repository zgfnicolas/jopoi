{
  "$schema": "https://antigravity.google/schemas/v1/settings.json",
  "trustedWorkspaces": [
    "/home/facundo/dev/gh/jopoi"
  ],
  "agentMode": "default",
  "enableTerminalSandbox": true,
  "permissions": {
    "allow": [
      "command(npm test)",
      "command(npm run typecheck)",
      "command(npm run test:api)",
      "command(npm run test:cli)",
      "command(npm run test:ui:tokens)",
      "command(npm run test:seo)",
      "command(npm run db:validate)",
      "command(npm run db:status)",
      "command(npm run db:check)",
      "command(npm run db:audit)",
      "command(npm run db:local:status)",
      "command(npm run delivery:check)",
      "command(npm run ops:status)",
      "command(npm run acceptance:check)",
      "command(git status)",
      "command(git diff)",
      "command(git log)",
      "command(git show)",
      "command(git branch)"
    ],
    "ask": [
      "command(npm install)",
      "command(npm ci)",
      "command(npm run dev)",
      "command(npm run build)",
      "command(npm run start)",
      "command(npm run delivery:build)",
      "command(npm run test:e2e)",
      "command(npm run db:generate)",
      "command(npm run db:migrate)",
      "command(npm run db:local)",
      "command(npm run db:local:setup)",
      "command(npm run db:local:stop)",
      "command(npm run hedera:topic)",
      "command(npm run maintenance)",
      "command(npm run contacts:export)",
      "command(npm run acceptance:live)",
      "command(regex:npm run s21:.*)",
      "command(git add)",
      "command(git commit)",
      "command(git push)",
      "command(git checkout)",
      "command(git switch)",
      "command(git merge)",
      "command(git rebase)",
      "mcp(*)"
    ],
    "deny": [
      "read_file(.env)",
      "read_file(.env.local)",
      "read_file(.env.production)",
      "read_file(.env.candidate)",
      "write_file(.env)",
      "write_file(.env.local)",
      "write_file(.env.production)",
      "write_file(.env.candidate)",
      "read_file(JOPOI.md)",
      "write_file(JOPOI.md)",
      "write_file(.git/)",
      "write_file(prisma/migrations/)",
      "command(regex:.*(cat|head|tail|less|more|grep|awk|sed).*\\.(env|env\\.local|env\\.production|env\\.candidate)\\b.*)",
      "command(sudo)",
      "command(rm -rf)",
      "command(git push --force)",
      "command(git push -f)",
      "command(git reset --hard)",
      "command(npx prisma migrate reset)"
    ]
  }
}
